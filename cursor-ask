#!/usr/bin/env bash
set -euo pipefail

model="auto"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model|-m)
      model="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -eq 0 ]; then
  echo "Usage: cursor-ask [-m|--model <model>] <prompt>" >&2
  exit 1
fi

args=(--mode ask --print --output-format stream-json --stream-partial-output --model "$model")

cursor agent "${args[@]}" "$*" 2>/dev/null \
  | python3 -c '
import sys, json

DIM = "\033[2m"
RESET = "\033[0m"
CYAN = "\033[36m"
YELLOW = "\033[33m"

in_thinking = False

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        obj = json.loads(line)
    except json.JSONDecodeError:
        continue

    t = obj.get("type")

    if t == "system" and obj.get("subtype") == "init":
        model_name = obj.get("model", "unknown")
        sys.stderr.write(f"{DIM}[model] {model_name}{RESET}\n")
        sys.stderr.flush()

    elif t == "thinking":
        sub = obj.get("subtype")
        if sub == "delta":
            if not in_thinking:
                sys.stderr.write(f"{DIM}[thinking] ")
                in_thinking = True
            sys.stderr.write(obj.get("text", ""))
            sys.stderr.flush()
        elif sub == "completed":
            if in_thinking:
                sys.stderr.write(f"{RESET}\n")
                sys.stderr.flush()
                in_thinking = False

    elif t == "assistant":
        if obj.get("model_call_id"):
            continue
        if "timestamp_ms" in obj:
            content = obj.get("message", {}).get("content", [])
            for block in content:
                if block.get("type") == "text":
                    sys.stdout.write(block["text"])
                    sys.stdout.flush()

    elif t == "tool_call":
        sub = obj.get("subtype")
        tc = obj.get("tool_call", {})
        if sub == "started":
            tool_name = ""
            tool_key = ""
            for key in tc:
                if key.endswith("ToolCall"):
                    tool_key = key
                    tool_name = key.replace("ToolCall", "")
                    break
            args_obj = tc.get(tool_key, {}).get("args", {}) if tool_key else {}
            desc = args_obj.get("description", "") or tc.get("description", "")
            detail = ""
            if tool_name == "grep":
                p = args_obj.get("pattern", "")
                path = args_obj.get("path", "")
                detail = f"\"{p}\" in {path}"
            elif tool_name == "shell":
                detail = args_obj.get("command", "")
            elif tool_name == "glob":
                detail = args_obj.get("pattern", "") or args_obj.get("glob", "")
            elif tool_name == "read":
                detail = args_obj.get("filePath", "") or args_obj.get("path", "")
            elif tool_name == "write":
                detail = args_obj.get("filePath", "") or args_obj.get("path", "")
            elif tool_name == "edit":
                detail = args_obj.get("filePath", "") or args_obj.get("path", "")
            else:
                detail = desc
                desc = ""

            line1 = f"[{tool_name}]"
            if desc:
                line1 += f" {desc}"
            sys.stderr.write(f"{CYAN}{line1}{RESET}\n")
            if detail:
                sys.stderr.write(f"{DIM}        > {detail}{RESET}\n")
            sys.stderr.flush()

    elif t == "result":
        pass

print()
'
